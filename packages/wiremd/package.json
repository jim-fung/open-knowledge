{
  "name": "wiremd",
  "version": "0.1.7",
  "description": "Vendored build of the wiremd text-first UI wireframing tool (upstream: github.com/akonan/wiremd, MIT). See README.md before updating.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./parser": {
      "types": "./dist/parser/index.d.ts",
      "import": "./dist/parser.js",
      "require": "./dist/parser.cjs"
    },
    "./renderer": {
      "types": "./dist/renderer/index.d.ts",
      "import": "./dist/renderer.js",
      "require": "./dist/renderer.cjs"
    },
    "./embed": {
      "types": "./dist/embed/index.d.ts",
      "import": "./dist/embed.js",
      "require": "./dist/embed.cjs"
    }
  },
  "scripts": {
    "sync": "node ./sync-from-upstream.mjs"
  },
  "dependencies": {
    "remark-gfm": "^4.0.0",
    "remark-parse": "^11.0.0",
    "unified": "^11.0.4"
  }
}
